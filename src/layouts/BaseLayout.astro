---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getSiteData, pageUrl, ui, type Language, type Page } from '../data/i18n';
interface Props { title?: string; description?: string; lang?: Language; page?: Page; localeUrls?: { zh: string; en: string }; }
const { lang = 'zh', page = 'home', localeUrls } = Astro.props;
const { profile } = getSiteData(lang);
const { title = `${profile.name} | ${ui[lang].siteTitle}`, description = profile.summary } = Astro.props;
const canonical = new URL(localeUrls?.[lang] ?? pageUrl(lang, page), Astro.site ?? Astro.url);
const altZh = new URL(localeUrls?.zh ?? pageUrl('zh', page), Astro.site ?? Astro.url);
const altEn = new URL(localeUrls?.en ?? pageUrl('en', page), Astro.site ?? Astro.url);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9ff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=megumin-m" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="zh-CN" href={altZh.toString()} />
    <link rel="alternate" hreflang="en" href={altEn.toString()} />
    <link rel="alternate" hreflang="x-default" href={altZh.toString()} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      try {
        const saved = localStorage.getItem('academic-theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch (_) {}
    </script>
  </head>
  <body>
    <div class="site-atmosphere" aria-hidden="true">
      <div class="ambient-orb ambient-orb-a"></div>
      <div class="ambient-orb ambient-orb-b"></div>
      <div class="ambient-orb ambient-orb-c"></div>
      <div class="ambient-grid"></div>
    </div>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script>
      // With ClientRouter, bundled scripts run once. Initialize page-specific handlers
      // on every navigation and clean them up before the next document is swapped in.
      let disposePage: (() => void) | undefined;

      const applyTheme = () => {
        try {
          const saved = localStorage.getItem('academic-theme');
          if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
        } catch { /* localStorage can be blocked */ }
      };

      const initPage = () => {
        disposePage?.();
        const cleanups: Array<() => void> = [];
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
        if (toggle) {
          const updateLabel = () => {
            const label = document.documentElement.dataset.theme === 'dark' ? toggle.dataset.lightLabel : toggle.dataset.darkLabel;
            toggle.setAttribute('aria-label', label ?? 'Theme');
            toggle.title = label ?? 'Theme';
          };
          const onClick = () => {
            const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem('academic-theme', next); } catch { /* ignore */ }
            updateLabel();
          };
          updateLabel();
          toggle.addEventListener('click', onClick);
          cleanups.push(() => toggle.removeEventListener('click', onClick));
        }

        const progress = document.querySelector<HTMLElement>('#scroll-progress');
        let frame = 0;
        const syncProgress = () => {
          if (!progress) return;
          const total = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = total <= 0 ? 0 : Math.min(1, Math.max(0, window.scrollY / total));
          progress.style.transform = `scaleX(${ratio})`;
        };
        const requestProgress = () => {
          if (!frame) frame = requestAnimationFrame(() => { frame = 0; syncProgress(); });
        };
        window.addEventListener('scroll', requestProgress, { passive: true });
        window.addEventListener('resize', requestProgress, { passive: true });
        syncProgress();
        cleanups.push(() => {
          window.removeEventListener('scroll', requestProgress);
          window.removeEventListener('resize', requestProgress);
          if (frame) cancelAnimationFrame(frame);
        });

        const typed = document.querySelector<HTMLElement>('[data-hero-typing]');
        if (typed && !reducedMotion) {
          const full = typed.dataset.fullText ?? typed.textContent ?? '';
          const characters = Array.from(full);
          typed.textContent = '';
          typed.classList.add('is-typing');
          let index = 0;
          let timer = 0;
          const step = () => {
            index = Math.min(index + 1, characters.length);
            typed.textContent = characters.slice(0, index).join('');
            if (index < characters.length) timer = window.setTimeout(step, 95);
            else timer = window.setTimeout(() => typed.classList.remove('is-typing'), 750);
          };
          timer = window.setTimeout(step, 250);
          cleanups.push(() => { window.clearTimeout(timer); typed.classList.remove('is-typing'); });
        }

        const revealItems = Array.from(document.querySelectorAll<HTMLElement>('.content-section, .contact-banner, .subpage-header, .project-grid-full, .blog-list'));
        if (!reducedMotion && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          }, { threshold: .075, rootMargin: '0px 0px -20px 0px' });
          for (const item of revealItems) {
            item.classList.add('reveal');
            observer.observe(item);
          }
          cleanups.push(() => observer.disconnect());
        }

        if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          for (const card of Array.from(document.querySelectorAll<HTMLElement>('.paper-card, .project-card'))) {
            const onMove = (event: MouseEvent) => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
              card.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
            };
            card.addEventListener('pointermove', onMove as EventListener, { passive: true });
            cleanups.push(() => card.removeEventListener('pointermove', onMove as EventListener));
          }
        }
        disposePage = () => cleanups.forEach((clean) => clean());
      };

      document.addEventListener('astro:after-swap', applyTheme);
      document.addEventListener('astro:page-load', initPage);
      document.addEventListener('astro:before-swap', () => disposePage?.());
    </script>
  </body>
</html>
