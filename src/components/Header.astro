---
import { pageUrl, ui, type Language, type Page } from '../data/i18n';
interface Props { active?: Page; lang?: Language; localeUrls?: { zh: string; en: string }; }
const { active = 'home', lang = 'zh', localeUrls } = Astro.props;
const text = ui[lang];
const links: Page[] = ['home', 'publications', 'projects', 'cv', 'blog'];
---
<header class="site-header">
  <a class="wordmark" href={pageUrl(lang, 'home')} aria-label="Megumin — Home"><span class="wordmark-symbol">✳</span> MEGUMIN<span class="wordmark-accent">/</span>AI</a>
  <nav class="primary-nav" aria-label={text.navLabel}>
    {links.map((key) => <a class:list={['nav-link', { active: key === active }]} href={pageUrl(lang, key)} aria-current={key === active ? 'page' : undefined}>{text[key]}</a>)}
  </nav>
  <nav class="language-switch" aria-label={text.languageLabel}>
    <a href={localeUrls?.zh ?? pageUrl('zh', active)} lang="zh-CN" class:list={['language-option', { active: lang === 'zh' }]} aria-current={lang === 'zh' ? 'page' : undefined} title="切换到中文">中</a>
    <span class="language-divider" aria-hidden="true">/</span>
    <a href={localeUrls?.en ?? pageUrl('en', active)} lang="en" class:list={['language-option', { active: lang === 'en' }]} aria-current={lang === 'en' ? 'page' : undefined} title="Switch to English">EN</a>
  </nav>
  <button class="theme-toggle" id="theme-toggle" type="button" title={text.switchTheme} aria-label={text.switchTheme} data-dark-label={text.switchTheme} data-light-label={text.switchLight}><span class="theme-glyph">◐</span></button>
</header>
