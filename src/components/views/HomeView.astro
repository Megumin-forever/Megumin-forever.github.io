---
import Shell from '../Shell.astro';
import { getSiteData, pageUrl, ui, type Language } from '../../data/i18n';
interface Props { lang: Language; }
const { lang } = Astro.props;
const text = ui[lang];
const { profile, news, education, publications, projects, experience, skills } = getSiteData(lang);
---
<Shell active="home" lang={lang}>
  <section class="hero" id="top">
    <div class="hero-aura hero-aura-one" aria-hidden="true"></div>
    <div class="hero-aura hero-aura-two" aria-hidden="true"></div>
    <svg class="hero-network" viewBox="0 0 470 410" fill="none" aria-hidden="true">
      <circle class="network-ring r1" cx="280" cy="200" r="148" />
      <circle class="network-ring r2" cx="280" cy="200" r="105" />
      <circle class="network-ring r3" cx="280" cy="200" r="58" />
      <path class="network-path" d="M85 100 171 158 280 53 375 122 415 252 329 331 196 342 124 260 85 100M171 158 280 200 375 122M280 200 329 331M280 200 124 260M196 342 171 158" />
      <circle class="node node-1" cx="85" cy="100" r="5" />
      <circle class="node node-2" cx="171" cy="158" r="6" />
      <circle class="node node-3" cx="280" cy="53" r="4" />
      <circle class="node node-4" cx="375" cy="122" r="6" />
      <circle class="node node-5" cx="415" cy="252" r="4" />
      <circle class="node node-6" cx="329" cy="331" r="5" />
      <circle class="node node-7" cx="196" cy="342" r="5" />
      <circle class="node node-8" cx="124" cy="260" r="4" />
      <circle class="network-center" cx="280" cy="200" r="16" />
      <circle class="network-core" cx="280" cy="200" r="5" />
    </svg>
    <div class="hero-content">
      <p class="eyebrow"><span class="eyebrow-line"></span> {text.heroEyebrow}</p>
      <h1 aria-label={`${text.heroLead} ${profile.name}.`}>{text.heroLead}<span class="hero-typing-viewport"><span class="hero-heading-gradient" data-hero-typing data-full-text={`${profile.name}.`} aria-hidden="true">{profile.name}.</span><span class="hero-heading-measure" aria-hidden="true">{profile.name}.</span></span></h1>
      <p class="hero-summary">{text.heroSummary}</p>
      <div class="hero-live-line"><span class="live-lead">{text.heroFocus}</span></div>
      <div class="hero-tag-list tag-list">{profile.researchAreas.map((tag) => <span class="tag">{tag}</span>)}</div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#publications">{text.heroWork} <span>↗</span></a>
        <a class="btn btn-secondary" href={pageUrl(lang, 'cv')}>{text.heroCv} <span>→</span></a>
      </div>
      <div class="hero-index"><span class="status-dot"></span> {text.heroFooter} <span class="hero-index-arrow">↗</span></div>
    </div>
  </section>

  <section class="content-section" id="about">
    <div class="section-heading"><span class="section-number">01 / INTRODUCTION</span><h2>{text.about} <em>{text.aboutEn}</em></h2></div>
    <p class="body-lead">{profile.about}</p>
    <div class="focus-chips">{profile.researchAreas.map((area) => <span>{area}</span>)}</div>
  </section>

  <section class="content-section" id="news">
    <div class="section-heading"><span class="section-number">02 / UPDATES</span><h2>{text.news} <em>{text.newsEn}</em></h2></div>
    <div class="news-list">
      {news.map((item) => <div class="news-item"><span class="item-date">{item.date}</span><p>{item.text} {item.url && <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-link">{text.viewNews}</a>}</p></div>)}
    </div>
  </section>

  <section class="content-section" id="publications">
    <div class="section-heading"><span class="section-number">03 / RESEARCH</span><h2>{text.publications} <em>{text.publicationsEn}</em></h2></div>
    <p class="section-intro">{text.publicationIntro}</p>
    <div class="paper-list">
      {publications.map((paper, i) => <article class="paper-card">
        <div class="paper-art"><span class="paper-art-index">0{i+1}</span><span class="paper-art-label">RESEARCH NOTE</span><div class="paper-art-lines"><i></i><i></i><i></i></div></div>
        <div class="paper-body">
          <p class="paper-venue">{paper.venue}</p><h3>{paper.title}</h3><p class="paper-authors">{paper.authors}</p>
          <p class="paper-description">{paper.description}</p>
          <div class="tag-list">{paper.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          <div class="paper-actions">
            {paper.paperUrl ? <a href={lang === "en" ? `/en${paper.paperUrl}` : paper.paperUrl}>{text.paper}</a> : <span>{text.missingPaper}</span>}
            {paper.codeUrl && <a href={paper.codeUrl} target="_blank" rel="noopener noreferrer">{text.code}</a>}
          </div>
        </div>
      </article>)}
    </div>
    <a class="section-more" href={pageUrl(lang, 'publications')}>{text.publications} <span>↗</span></a>
  </section>

  {projects.length > 0 && <section class="content-section" id="projects">
    <div class="section-heading"><span class="section-number">04 / BUILD</span><h2>{text.featuredProjects} <em>{text.featuredProjectsEn}</em></h2></div>
    <div class="project-grid">
      {projects.map((project, i) => <article class="project-card"><span class="project-id">FOCUS / 0{i+1}</span><h3>{project.title}</h3><p class="project-category">{project.category}</p><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>{project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">{text.seeProject}</a>}</article>)}
    </div>
    <a class="section-more" href={pageUrl(lang, 'projects')}>{text.seeAllProjects} <span>↗</span></a>
  </section>}

  <section class="content-section" id="experience">
    <div class="section-heading"><span class="section-number">05 / JOURNEY</span><h2>{text.experience} <em>{text.experienceEn}</em></h2></div>
    <div class="timeline">
      {experience.map((item) => <article class="timeline-entry"><span class="timeline-point"></span><p class="item-date">{item.period}</p><h3>{item.title}</h3><p class="timeline-place">{item.place}</p><p>{item.detail}</p></article>)}
    </div>
  </section>

  <section class="content-section" id="education">
    <div class="section-heading"><span class="section-number">06 / BACKGROUND</span><h2>{text.education} <em>{text.educationEn}</em></h2></div>
    {education.map((item) => <div class="education-entry"><span class="item-date">{item.period}</span><h3>{item.degree}</h3><p class="timeline-place">{item.institution}</p><p>{item.detail}</p>{"logo" in item && item.logo && <img class="education-logo" src={item.logo} alt={item.institution} loading="lazy" />}</div>)}
    {skills.length > 0 && <div class="skills-grid">{skills.map((group) => <div class="skill-card"><h4>{group.group}</h4><div class="tag-list">{group.items.map((name) => <span class="tag">{name}</span>)}</div></div>)}</div>}
  </section>

  <section class="contact-banner" id="contact"><span class="section-number">{text.letsConnect}</span><h2>{text.connectTitle}</h2><p>{text.connectDesc}</p><a href={profile.email ? `mailto:${profile.email}` : profile.github} class="btn btn-primary" target={profile.email ? undefined : "_blank"} rel={profile.email ? undefined : "noopener noreferrer"}>{profile.email ? text.sendMail : text.githubContact} <span>↗</span></a></section>
</Shell>
