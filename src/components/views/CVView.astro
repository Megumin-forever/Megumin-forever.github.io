---
import Shell from '../Shell.astro';
import { getSiteData, ui, type Language } from '../../data/i18n';
interface Props { lang: Language; }
const { lang } = Astro.props;
const text = ui[lang];
const { profile, education, experience, awards, skills } = getSiteData(lang);
---
<Shell title={`${text.cvHeader} | Megumin`} active="cv" lang={lang}>
  <section class="subpage-header"><p class="eyebrow"><span class="eyebrow-line"></span> CURRICULUM VITAE</p><h1>{text.cvHeader}<span class="accent-dot">.</span></h1><p>{text.cvSubtitle}</p>{profile.cvUrl ? <a class="btn btn-primary" href={profile.cvUrl} target="_blank">{text.pdfCv}</a> : null}</section>
  <section class="content-section"><div class="section-heading"><span class="section-number">01 / EDUCATION</span><h2>{text.cvEducation}</h2></div>{education.map((item) => <div class="education-entry"><p class="item-date">{item.period}</p><h3>{item.degree}</h3><p class="timeline-place">{item.institution}</p><p>{item.detail}</p>{"logo" in item && item.logo && <img class="education-logo" src={item.logo} alt={item.institution} loading="lazy" />}</div>)}</section>
  <section class="content-section"><div class="section-heading"><span class="section-number">02 / EXPERIENCE</span><h2>{text.cvExperience}</h2></div><div class="timeline">{experience.map((item) => <article class="timeline-entry"><span class="timeline-point"></span><p class="item-date">{item.period}</p><h3>{item.title}</h3><p class="timeline-place">{item.place}</p><p>{item.detail}</p></article>)}</div></section>
  <section class="content-section"><div class="section-heading"><span class="section-number">03 / HONORS</span><h2>{text.cvAwards}</h2></div><div class="timeline">{awards.map((award) => <article class="timeline-entry"><span class="timeline-point"></span><p class="item-date">{award.period}</p><h3>{award.name}</h3><p class="timeline-place">{award.issuer}</p>{award.description && <p>{award.description}</p>}</article>)}</div></section>
  {skills.length > 0 && <section class="content-section"><div class="section-heading"><span class="section-number">04 / SKILLS</span><h2>{text.cvSkills}</h2></div><div class="skills-grid">{skills.map((group) => <div class="skill-card"><h4>{group.group}</h4><div class="tag-list">{group.items.map((name) => <span class="tag">{name}</span>)}</div></div>)}</div></section>}
</Shell>
